code = "shader_type canvas_item;
render_mode blend_add;

uniform float whiteWeight : hint_range(0.0, 1.0);
uniform float showLength : hint_range(0.0, 2.0);



void fragment() {
// ColorConstant:13
	vec4 n_out13p0 = vec4(1.000000, 1.000000, 1.000000, 1.000000);


	vec4 n_out20p0;
// Texture2D:20
	n_out20p0 = texture(TEXTURE, UV);


// VectorOp:23
	vec3 n_out23p0 = vec3(n_out13p0.xyz) * vec3(n_out20p0.xyz);


// Input:19
	vec4 n_out19p0 = COLOR;


// FloatParameter:26
	float n_out26p0 = whiteWeight;


// FloatFunc:27
	float n_out27p0 = 1.0 - n_out26p0;


// Mix:25
	vec3 n_out25p0 = mix(n_out23p0, vec3(n_out19p0.xyz), vec3(n_out27p0));


// Input:2
	vec2 n_out2p0 = UV;
	float n_out2p2 = n_out2p0.g;


// FloatOp:6
	float n_in6p1 = 1.00000;
	float n_out6p0 = n_out2p2 - n_in6p1;


// FloatParameter:5
	float n_out5p0 = showLength;


// FloatOp:4
	float n_out4p0 = n_out6p0 + n_out5p0;


// Input:7
	vec2 n_out7p0 = UV;
	float n_out7p2 = n_out7p0.g;


// Input:8
	vec2 n_out8p0 = UV;
	float n_out8p2 = n_out8p0.g;


// FloatFunc:9
	float n_out9p0 = 1.0 - n_out8p2;


// FloatOp:10
	float n_out10p0 = n_out7p2 * n_out9p0;


// FloatOp:11
	float n_in11p1 = 4.00000;
	float n_out11p0 = n_out10p0 * n_in11p1;


// FloatOp:12
	float n_out12p0 = n_out4p0 * n_out11p0;


// Output:0
	COLOR.rgb = n_out25p0;
	COLOR.a = n_out12p0;


}
"
