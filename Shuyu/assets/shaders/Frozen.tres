code = "shader_type canvas_item;
render_mode blend_mix;

uniform sampler2D MainTex;



void vertex() {
	vec4 n_out6p0;
// Texture2D:6
	n_out6p0 = texture(MainTex, UV);


// Input:2
	float n_out2p0 = TIME;


// FloatOp:11
	float n_in11p1 = 1.20000;
	float n_out11p0 = n_out2p0 * n_in11p1;


// FloatFunc:8
	float n_out8p0 = sin(n_out11p0);


// FloatOp:9
	float n_in9p1 = 3.00000;
	float n_out9p0 = n_out8p0 + n_in9p1;


// FloatOp:10
	float n_out10p0 = n_out6p0.x * n_out9p0;


// Output:0
	COLOR.a = n_out10p0;


}
"
